---
/**
 * Long-form guide layout: Article + FAQ schema, visible "last updated" date,
 * an answer-first summary box (what AI assistants and featured snippets extract), and prose styling.
 */
import Layout from "./Layout.astro";
import CTASection from "../components/CTASection.astro";
import FAQ from "../components/FAQ.astro";
import type { Guide } from "../data/guides";
import type { FAQ as FAQType } from "../data/services";
import { guides } from "../data/guides";
import { site } from "../data/site";
import { article, faqPage, abs } from "../lib/schema";

interface Props {
  guide: Guide;
  faqs?: FAQType[];
  schema?: Record<string, unknown>[];
}

const { guide, faqs = [], schema = [] } = Astro.props;
const path = `/guides/${guide.slug}/`;
const fmt = (d: string) => new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
const others = guides.filter((g) => g.slug !== guide.slug);
---

<Layout
  title={guide.seoTitle}
  description={guide.description}
  ogType="article"
  datePublished={guide.published}
  dateModified={guide.updated}
  breadcrumbs={[
    { name: "Guides", path: "/guides/" },
    { name: guide.title, path },
  ]}
  schema={[
    article({ path, headline: guide.title, description: guide.description, datePublished: guide.published, dateModified: guide.updated, image: abs("/og-image.png") }),
    ...(faqs.length ? [faqPage(path, faqs)] : []),
    ...schema,
  ]}
>
  <article>
    <header class="relative overflow-hidden pt-12 pb-10 sm:pt-16">
      <div class="glow -top-24 left-1/4 h-80 w-[32rem] bg-gold-500/15"></div>
      <div class="container-page relative max-w-3xl">
        <span class="eyebrow">Guide</span>
        <h1 class="mt-6 text-3xl font-semibold text-white sm:text-5xl">{guide.title}</h1>
        <p class="mt-5 text-sm text-white/45">
          By the {site.name} team · Updated <time datetime={guide.updated}>{fmt(guide.updated)}</time> · {guide.readMinutes} min read
        </p>
      </div>
    </header>

    <div class="container-page max-w-3xl">
      <div class="glass-card border-gold-400/30 p-6 sm:p-8">
        <p class="text-xs font-semibold tracking-[0.2em] text-gold-300 uppercase">Quick answer</p>
        <p class="mt-3 text-base leading-relaxed text-white/85">{guide.answer}</p>
      </div>

      <div class="prose-kyk mt-12">
        <slot />
      </div>
    </div>
  </article>

  {faqs.length > 0 && <FAQ faqs={faqs} title="Related questions" />}

  <section class="py-12">
    <div class="container-page max-w-3xl">
      <h2 class="text-xl font-semibold text-white">More guides</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {others.map((g) => (
          <a href={`/guides/${g.slug}/`} class="glass-card p-6">
            <h3 class="text-base font-semibold text-white">{g.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Want an exact quote for your project?" description="Tell us what you need — we'll send a fixed, itemised estimate within one business day, free." />
</Layout>
