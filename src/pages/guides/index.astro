---
import Layout from "../../layouts/Layout.astro";
import CTASection from "../../components/CTASection.astro";
import { guides } from "../../data/guides";
import { site } from "../../data/site";
import { abs } from "../../lib/schema";
---

<Layout
  title="Website & App Development Guides"
  description={`Practical guides from ${site.name}: website and mobile app development costs in India, how to create a website for your business, and how to choose a developer.`}
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Guides", path: "/guides/" }]}
  schema={[
    {
      "@type": "ItemList",
      "@id": abs("/guides/#list"),
      itemListElement: guides.map((g, i) => ({ "@type": "ListItem", position: i + 1, url: abs(`/guides/${g.slug}/`), name: g.title })),
    },
  ]}
>
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-16">
    <div class="glow -top-24 left-1/3 h-80 w-[32rem] bg-gold-500/20"></div>
    <div class="container-page relative">
      <span class="eyebrow">Guides</span>
      <h1 class="mt-6 max-w-3xl text-4xl font-semibold text-white sm:text-5xl">
        Website &amp; app development <span class="gold-text">guides</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/60 sm:text-lg">
        Honest, practical answers to the questions businesses ask before building a website, app or
        software product — with real numbers.
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="container-page grid gap-6 lg:grid-cols-3">
      {
        guides.map((g) => (
          <a href={`/guides/${g.slug}/`} class="glass-card flex flex-col p-8">
            <p class="text-xs text-white/40">
              <time datetime={g.updated}>{new Date(g.updated).toLocaleDateString("en-IN", { month: "short", year: "numeric" })}</time> · {g.readMinutes} min read
            </p>
            <h2 class="mt-3 text-xl font-semibold text-white">{g.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{g.description}</p>
            <span class="mt-6 text-sm font-medium text-gold-300">Read the guide →</span>
          </a>
        ))
      }
    </div>
  </section>

  <CTASection />
</Layout>
