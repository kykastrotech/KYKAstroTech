---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTASection from "../components/CTASection.astro";
import FAQ from "../components/FAQ.astro";
import { services } from "../data/services";
import { site, techStack } from "../data/site";
import { generalFaqs } from "../data/faqs";
import { guides } from "../data/guides";
import { faqPage, abs, ids } from "../lib/schema";

const values = [
  { title: "Innovation", detail: "We build with modern tools and fresh thinking, not templates." },
  { title: "Reliability", detail: "Deadlines, communication, and code you can depend on." },
  { title: "Performance", detail: "Fast, lightweight products — for your users and your budget." },
  { title: "Growth Partner", detail: "We stick around after launch to help you scale." },
];

const process = [
  { step: "01", title: "Discover", detail: "A free consultation to learn your business, users and goals." },
  { step: "02", title: "Design & Build", detail: "UI design and development move in tight, visible loops." },
  { step: "03", title: "Test & Launch", detail: "Real-device testing, SEO checks, then a smooth go-live." },
  { step: "04", title: "Support & Scale", detail: "We stay on to maintain, improve and grow what we built." },
];

const audiences = [
  { title: "Startups & founders", detail: "MVPs, SaaS products and investor-ready prototypes, built fast." },
  { title: "Small & medium businesses", detail: "Websites, booking systems and apps that bring in customers." },
  { title: "D2C & retail brands", detail: "E-commerce stores with payments, shipping and marketing built in." },
  { title: "Professionals", detail: "Doctors, lawyers, coaches, consultants and agencies who need to be found online." },
];

const homeFaqs = generalFaqs.slice(0, 8);

const schema = [
  faqPage("/", homeFaqs),
  {
    "@type": "ItemList",
    "@id": abs("/#services"),
    name: `${site.name} services`,
    itemListElement: services.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.heading,
      url: abs(`/services/${s.slug}/`),
    })),
  },
  {
    "@type": "Brand",
    "@id": abs("/#brand"),
    name: site.name,
    logo: { "@id": ids.logo },
    slogan: site.tagline,
  },
];
---

<Layout
  title="KYK AstroTech | Website & App Development Company in India"
  description="KYK AstroTech is an IT company in India building fast, SEO-ready websites, Android & iOS apps, e-commerce stores and AI software. Free consultation & quote."
  schema={schema}
>
  <section class="relative overflow-hidden pt-20 pb-24 sm:pt-28 sm:pb-32">
    <div class="glow -top-32 left-1/2 h-96 w-[44rem] -translate-x-1/2 bg-gold-500/25"></div>
    <div class="glow top-40 right-0 h-72 w-72 bg-gold-400/10"></div>

    <div class="container-page relative flex flex-col items-center text-center">
      <span class="eyebrow">IT &amp; Software Company · India · Worldwide</span>
      <h1 class="mt-6 max-w-4xl text-4xl font-semibold text-white sm:text-6xl">
        Website, App &amp; AI Development — <span class="gold-text">building ideas into technology</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/60 sm:text-lg">
        {site.legalName} designs and builds websites, mobile apps, e-commerce stores and AI-powered
        software for startups and businesses that want to move fast without compromising on quality.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/contact/" class="btn-primary">Get a Free Quote</a>
        <a href="/services/" class="btn-secondary">Explore Services</a>
      </div>

      <div class="mt-20 grid w-full max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
        {
          values.map((v) => (
            <div class="glass-card px-4 py-6 text-center">
              <p class="font-display text-sm font-semibold text-gold-300">{v.title}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Entity definition: a clear, factual "who we are" block that search engines and AI assistants can quote. -->
  <section class="py-12" aria-labelledby="who-we-are">
    <div class="container-page">
      <div class="glass-card mx-auto max-w-4xl p-8 sm:p-12">
        <h2 id="who-we-are" class="text-2xl font-semibold text-white sm:text-3xl">Who is KYK AstroTech?</h2>
        <p class="mt-4 text-base leading-relaxed text-white/70">
          <strong class="text-white">{site.legalName}</strong> is an Indian IT and software development company. We build{" "}
          <a href="/services/web-development/" class="text-gold-300 hover:underline">business websites and web applications</a>,{" "}
          <a href="/services/mobile-app-development/" class="text-gold-300 hover:underline">Android and iOS mobile apps</a>,{" "}
          <a href="/services/ecommerce-development/" class="text-gold-300 hover:underline">e-commerce stores</a>,{" "}
          <a href="/services/ui-ux-design/" class="text-gold-300 hover:underline">UI/UX designs</a> and{" "}
          <a href="/services/ai-software-solutions/" class="text-gold-300 hover:underline">custom AI-powered software</a>, and we provide ongoing{" "}
          <a href="/services/it-support-maintenance/" class="text-gold-300 hover:underline">website maintenance and IT support</a>.
          We are remote-first, based in India, and work with clients across India, the US, UK, UAE, Canada and Australia.
          Alongside client projects we build our own products, including{" "}
          <a href="/portfolio/" class="text-gold-300 hover:underline">AstroGuru</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">What We Do</span>
        <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">
          Web, app &amp; software development services
        </h2>
        <p class="mt-4 text-base text-white/60">
          From the first line of code to the systems that keep you running, one team covers the full
          stack of designing, building and maintaining modern software.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Who We Work With</span>
        <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">Built for businesses at every stage</h2>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          audiences.map((a) => (
            <div class="glass-card p-8">
              <h3 class="text-lg font-semibold text-white">{a.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/60">{a.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page grid items-center gap-16 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Why KYK AstroTech</span>
        <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">
          Built on values, not just deliverables
        </h2>
        <p class="mt-4 text-base leading-relaxed text-white/60">
          We keep teams small and senior, communication direct, and scope honest — so what we
          ship actually matches what you needed. Every quote is fixed and itemised, and you own
          100% of the code.
        </p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {
            values.map((v) => (
              <div>
                <h3 class="font-display text-lg font-semibold text-gold-300">{v.title}</h3>
                <p class="mt-2 text-sm text-white/60">{v.detail}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="glass-card relative overflow-hidden p-10">
        <div class="glow -bottom-10 -right-10 h-56 w-56 bg-gold-500/20"></div>
        <div class="relative flex items-center gap-4">
          <img src="/images/logo-mark.png" alt={`${site.name} logo`} width="56" height="56" loading="lazy" class="h-14 w-14 rounded-xl object-contain" />
          <div>
            <p class="font-display text-lg font-semibold text-white">Currently Building</p>
            <p class="text-sm text-white/50">In active development</p>
          </div>
        </div>
        <h3 class="relative mt-8 text-2xl font-semibold text-white">AstroGuru</h3>
        <p class="relative mt-3 text-sm leading-relaxed text-white/60">
          A digital astrology, palm reading &amp; numerology platform — one of the products our
          own team is designing and building end to end.
        </p>
        <a
          href={site.astroguru.url}
          target="_blank"
          rel="noopener"
          class="relative mt-6 inline-flex items-center gap-2 text-sm font-medium text-gold-300 hover:text-gold-200"
        >
          Visit AstroGuru
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">How We Work</span>
        <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">A process built for clarity</h2>
      </div>

      <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p, i) => (
            <li class="relative">
              <p class="font-display text-4xl font-bold text-white/10" aria-hidden="true">{p.step}</p>
              <h3 class="mt-2 text-lg font-semibold text-white">{p.title}</h3>
              <p class="mt-2 text-sm text-white/60">{p.detail}</p>
              {i < process.length - 1 && (
                <div class="absolute top-4 -right-4 hidden h-px w-8 bg-white/10 lg:block" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Technology</span>
        <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">Technologies we build with</h2>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          techStack.map((t) => (
            <div class="glass-card p-8">
              <h3 class="text-base font-semibold text-gold-300">{t.group}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {t.items.map((item) => (
                  <li class="rounded-full border border-white/10 px-3 py-1 text-xs text-white/70">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <span class="eyebrow">Guides</span>
          <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">Planning a website or app?</h2>
        </div>
        <a href="/guides/" class="btn-secondary">All guides</a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          guides.map((g) => (
            <a href={`/guides/${g.slug}/`} class="glass-card flex flex-col p-8">
              <p class="text-xs text-white/40">{g.readMinutes} min read</p>
              <h3 class="mt-3 text-lg font-semibold text-white">{g.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/60">{g.description}</p>
              <span class="mt-6 text-sm font-medium text-gold-300">Read the guide →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FAQ faqs={homeFaqs} title="Questions businesses ask us" />

  <CTASection />
</Layout>
