---
import Layout from "../../layouts/Layout.astro";
import CTASection from "../../components/CTASection.astro";
import FAQ from "../../components/FAQ.astro";
import Icon from "../../components/Icon.astro";
import { services } from "../../data/services";
import { guides } from "../../data/guides";
import { site } from "../../data/site";
import { serviceNode, faqPage } from "../../lib/schema";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const otherServices = services.filter((s) => s.slug !== service.slug);
const path = `/services/${service.slug}/`;
const relatedGuides = guides.filter((g) =>
  service.slug === "mobile-app-development" ? g.slug.includes("app") : !g.slug.includes("app"),
);
---

<Layout
  title={service.seoTitle}
  description={service.metaDescription}
  pageType="WebPage"
  breadcrumbs={[
    { name: "Services", path: "/services/" },
    { name: service.title, path },
  ]}
  schema={[serviceNode(service), faqPage(path, service.faqs)]}
>
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-16">
    <div class="glow -top-24 left-1/4 h-80 w-[32rem] bg-gold-500/20"></div>
    <div class="container-page relative">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gold-400/10 text-gold-300">
        <Icon path={service.icon} class="h-7 w-7" />
      </div>
      <p class="mt-6 text-sm font-semibold tracking-[0.2em] text-gold-300 uppercase">{service.title}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold text-white sm:text-5xl">{service.heading}</h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/60 sm:text-lg">{service.summary}</p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/contact/" class="btn-primary">Get a Free Quote</a>
        <a href="#faq" class="btn-secondary">Pricing &amp; FAQs</a>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container-page grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-5 text-base leading-relaxed text-white/70">
        <h2 class="text-2xl font-semibold text-white sm:text-3xl">{service.title} by {site.name}</h2>
        {service.intro.map((para) => <p>{para}</p>)}
        <p><strong class="text-white">Timeline:</strong> {service.timeline}</p>
      </div>
      <aside class="glass-card h-fit p-8">
        <h2 class="text-lg font-semibold text-white">Ideal for</h2>
        <ul class="mt-5 space-y-3 text-sm text-white/70">
          {
            service.idealFor.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-300" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">What's included</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          service.features.map((feature) => (
            <li class="glass-card flex items-center gap-4 p-5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-400/10 text-gold-300" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-sm text-white/80">{feature}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">How we deliver it</h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          service.process.map((step, i) => (
            <li>
              <p class="font-display text-4xl font-bold text-white/10" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="mt-2 text-lg font-semibold text-white">{step.title}</h3>
              <p class="mt-2 text-sm text-white/60">{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <FAQ faqs={service.faqs} title={`${service.title}: common questions`} />

  {
    relatedGuides.length > 0 && (
      <section class="py-12">
        <div class="container-page">
          <h2 class="text-2xl font-semibold text-white sm:text-3xl">Helpful guides</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {relatedGuides.map((g) => (
              <a href={`/guides/${g.slug}/`} class="glass-card p-6">
                <h3 class="text-base font-semibold text-white">{g.title}</h3>
                <p class="mt-2 text-sm text-white/50">{g.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-16">
    <div class="container-page">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Other services</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          otherServices.map((s) => (
            <a href={`/services/${s.slug}/`} class="glass-card p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gold-400/10 text-gold-300">
                <Icon path={s.icon} class="h-5 w-5" />
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">{s.title}</h3>
              <p class="mt-1 text-sm text-white/50">{s.short}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title={`Ready to start your ${service.title.toLowerCase()} project?`}
    description={`Tell us about your goals — we'll reply within one business day with next steps and a free quote.`}
  />
</Layout>
