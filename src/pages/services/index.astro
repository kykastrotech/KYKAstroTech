---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CTASection from "../../components/CTASection.astro";
import { services } from "../../data/services";
import { site } from "../../data/site";
---

<Layout title="Services" description={`Explore ${site.legalName}'s services — web development, mobile apps, AI & software solutions, and IT support.`}>
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28">
    <div class="glow -top-24 right-1/4 h-80 w-[32rem] bg-gold-500/20"></div>
    <div class="container-page relative text-center">
      <span class="eyebrow">What We Do</span>
      <h1 class="mx-auto mt-6 max-w-2xl text-4xl font-semibold text-white sm:text-5xl">
        Services built around your <span class="gold-text">growth</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/60 sm:text-lg">
        Four core disciplines, delivered by one senior team — so your product, app, and
        infrastructure all feel like they were built together, because they were.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-6 sm:grid-cols-2">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <CTASection />
</Layout>
