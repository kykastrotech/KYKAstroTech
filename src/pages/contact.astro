---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { services } from "../data/services";
---

<Layout
  title="Contact Us — Get a Free Website or App Quote"
  description={`Contact ${site.legalName} for a free consultation and quote on your website, app, e-commerce or AI software project. Reply within one business day.`}
  pageType="ContactPage"
  breadcrumbs={[{ name: "Contact", path: "/contact/" }]}
>
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-16">
    <div class="glow -top-24 left-1/3 h-80 w-[32rem] bg-gold-500/20"></div>
    <div class="container-page relative text-center">
      <span class="eyebrow">Contact</span>
      <h1 class="mx-auto mt-6 max-w-2xl text-4xl font-semibold text-white sm:text-5xl">
        Contact KYK AstroTech — <span class="gold-text">let's build together</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/60 sm:text-lg">
        Tell us a bit about your project and we'll get back to you within one business day.
      </p>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div class="glass-card h-fit p-10">
        <h2 class="text-lg font-semibold text-white">Contact details</h2>
        <ul class="mt-6 space-y-5 text-sm">
          <li>
            <p class="text-white/40">Email</p>
            <a href={`mailto:${site.email}`} class="text-white/80 hover:text-gold-300">{site.email}</a>
          </li>
          <li>
            <p class="text-white/40">LinkedIn</p>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-gold-300">
              linkedin.com/company/kykastrotech
            </a>
          </li>
          <li>
            <p class="text-white/40">Instagram</p>
            <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-gold-300">
              @kykastrotech
            </a>
          </li>
          {site.phone && (
            <li>
              <p class="text-white/40">Phone</p>
              <a href={`tel:${site.phone.replace(/[^+\d]/g, "")}`} class="text-white/80 hover:text-gold-300">{site.phone}</a>
            </li>
          )}
          {site.whatsapp && (
            <li>
              <p class="text-white/40">WhatsApp</p>
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-gold-300">Chat on WhatsApp</a>
            </li>
          )}
          <li>
            <p class="text-white/40">Location</p>
            <p class="text-white/80">{site.locationLabel}</p>
          </li>
        </ul>
      </div>

      <form
        class="glass-card space-y-5 p-10"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <!--
          Free form backend via Web3Forms (no server needed, generous free tier).
          The access key is public by design — it can only send submissions to our inbox.
        -->
        <input type="hidden" name="access_key" value="4a05e66b-461d-4304-938b-734a3751e80a" />
        <input type="hidden" name="subject" value="New inquiry from kykastrotech.com" />
        <input type="hidden" name="redirect" value="https://kykastrotech.com/thank-you/" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-2 block text-sm text-white/60">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/30 outline-none focus:border-gold-400/50"
              autocomplete="name"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm text-white/60">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/30 outline-none focus:border-gold-400/50"
              autocomplete="email"
              placeholder="you@company.com"
            />
          </div>
        </div>

        <div>
          <label for="service" class="mb-2 block text-sm text-white/60">What do you need help with?</label>
          <select
            id="service"
            name="service"
            class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none focus:border-gold-400/50"
          >
            {services.map((s) => <option class="bg-ink" value={s.title}>{s.title}</option>)}
            <option class="bg-ink" value="Other">Something else</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block text-sm text-white/60">Project details</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/30 outline-none focus:border-gold-400/50"
            placeholder="Tell us about your project, timeline, and budget."
          ></textarea>
        </div>

        <button type="submit" class="btn-primary w-full">Send Message</button>
        <p class="text-center text-xs text-white/40">
          Prefer email? Reach us directly at <a href={`mailto:${site.email}`} class="text-gold-300">{site.email}</a>
        </p>
      </form>
    </div>
  </section>
</Layout>
