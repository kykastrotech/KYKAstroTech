---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Have a project in mind?",
  description = "Tell us where you want to go — we'll help you build the technology to get there.",
} = Astro.props;
---

<section class="relative overflow-hidden py-24">
  <div class="glow -top-20 left-1/2 h-72 w-[36rem] -translate-x-1/2 bg-gold-500/20"></div>
  <div class="container-page relative">
    <div class="glass-card flex flex-col items-center gap-6 px-8 py-16 text-center sm:px-16">
      <h2 class="max-w-2xl text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
      <p class="max-w-xl text-base text-white/60">{description}</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="/contact/" class="btn-primary">Start a Conversation</a>
        <a href="/services/" class="btn-secondary">Explore Services</a>
      </div>
    </div>
  </div>
</section>
