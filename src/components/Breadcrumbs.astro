---
import type { Crumb } from "../lib/schema";

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const all = [{ name: "Home", path: "/" }, ...crumbs];
---

<nav aria-label="Breadcrumb" class="container-page pt-6">
  <ol class="flex flex-wrap items-center gap-2 text-xs text-white/40">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-2">
          {i < all.length - 1 ? (
            <>
              <a href={c.path} class="transition hover:text-gold-300">{c.name}</a>
              <span aria-hidden="true">/</span>
            </>
          ) : (
            <span aria-current="page" class="text-white/60">{c.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
