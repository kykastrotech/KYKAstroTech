---
interface Props {
  path: string;
  class?: string;
}

const { path, class: className = "h-6 w-6" } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
  <path stroke-linecap="round" stroke-linejoin="round" d={path} />
</svg>
