---
import { footerLinks, site } from "../data/site";
import { guides } from "../data/guides";
import { services } from "../data/services";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-ink-soft">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/logo-mark.png" alt={`${site.name} logo`} width="36" height="36" loading="lazy" class="h-9 w-9 rounded-lg object-contain" />
        <span class="font-display text-base font-semibold text-white">
          KYK <span class="gold-text">AstroTech</span>
        </span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
        {site.legalName} — website, mobile app, e-commerce and AI software development company in India.
      </p>
      <div class="mt-6 flex gap-3">
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/70 transition hover:border-gold-400/50 hover:text-gold-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"></path>
          </svg>
        </a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/70 transition hover:border-gold-400/50 hover:text-gold-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
            <circle cx="12" cy="12" r="3.6" />
            <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={`mailto:${site.email}`}
          aria-label="Email"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/70 transition hover:border-gold-400/50 hover:text-gold-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-11Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.5 6 8.5 6.5L20.5 6" />
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold tracking-wide text-white">Company</h3>
      <ul class="mt-4 space-y-3">
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/60 transition hover:text-gold-300">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold tracking-wide text-white">Services</h3>
      <ul class="mt-4 space-y-3">
        {
          services.map((service) => (
            <li>
              <a href={`/services/${service.slug}/`} class="text-sm text-white/60 transition hover:text-gold-300">
                {service.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold tracking-wide text-white">Get in touch</h3>
      <ul class="mt-4 space-y-3 text-sm text-white/60">
        <li>
          <a href={`mailto:${site.email}`} class="transition hover:text-gold-300">{site.email}</a>
        </li>
        {site.phone && (
          <li>
            <a href={`tel:${site.phone.replace(/[^+\d]/g, "")}`} class="transition hover:text-gold-300">{site.phone}</a>
          </li>
        )}
        {site.whatsapp && (
          <li>
            <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="transition hover:text-gold-300">WhatsApp us</a>
          </li>
        )}
        <li>{site.locationLabel}</li>
      </ul>
      <h3 class="mt-8 text-sm font-semibold tracking-wide text-white">Guides</h3>
      <ul class="mt-4 space-y-3">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`} class="text-sm text-white/60 transition hover:text-gold-300">{g.seoTitle.replace(/ \(.*\)$/, "")}</a>
          </li>
        ))}
      </ul>
      <a href="/contact/" class="btn-secondary mt-5 w-full">Start a Project</a>
    </div>
  </div>

  <div class="border-t border-white/5 py-6">
    <div class="container-page flex flex-col items-center justify-between gap-3 text-xs text-white/40 sm:flex-row">
      <p>&copy; {year} {site.legalName}{site.cin && ` · CIN ${site.cin}`}. All rights reserved.</p>
      <p><a href="/sitemap.xml" class="hover:text-gold-300">Sitemap</a> · Designed &amp; built by the KYK AstroTech team.</p>
    </div>
  </div>
</footer>
