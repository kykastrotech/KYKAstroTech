---
/**
 * Accessible, crawlable FAQ accordion (native <details>, no JavaScript).
 * Answers are in the HTML, so Google and AI crawlers can read them.
 * Pair with faqPage() JSON-LD on the same page.
 */
import type { FAQ } from "../data/services";

interface Props {
  faqs: FAQ[];
  title?: string;
  eyebrow?: string;
  id?: string;
}

const { faqs, title = "Frequently asked questions", eyebrow = "FAQ", id = "faq" } = Astro.props;
---

<section id={id} class="py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
    </div>
    <div class="mx-auto mt-12 max-w-3xl space-y-4">
      {
        faqs.map((f, i) => (
          <details class="glass-card group p-6" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left">
              <h3 class="text-base font-semibold text-white sm:text-lg">{f.q}</h3>
              <span class="mt-1 shrink-0 text-gold-300 transition group-open:rotate-45" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-white/65 sm:text-base">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
